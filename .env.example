# =============================================================
# VoiceAI — Outpero-style AI voice calling platform
# Copy to .env and fill in real values. NEVER commit .env
# =============================================================

# --- App ---
APP_ENV=development
APP_NAME=VoiceAI
DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL + pgvector) ---
# Example local: postgresql+asyncpg://nenu:nenu@localhost:5432/VoiceAI
DATABASE_URL=postgresql+asyncpg://nenu:nenu@localhost:5432/VoiceAI
# Sync URL used by Alembic (asyncpg is not supported by Alembic directly)
DATABASE_URL_SYNC=postgresql+psycopg2://nenu:nenu@localhost:5432/VoiceAI

# --- Redis (Celery broker / result backend / rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Security / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Argon2 / bcrypt cost placeholder (bcrypt default 12)
PASSWORD_BCRYPT_ROUNDS=12

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Sarvam AI (primary provider) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
# Realtime STT WebSocket endpoint (docs: /speech-to-text-realtime/ws)
SARVAM_REALTIME_STT_WSS=wss://api.sarvam.ai/speech-to-text-realtime/ws
# Default voice name for Sarvam TTS (bulbul:v3 default speaker)
SARVAM_TTS_VOICE=shubh  # config uses sarvam_tts_voice
# Audio encoding handed between Twilio and Sarvam (mu-law 8kHz mono round-trip)
SARVAM_AUDIO_ENCODING=mulaw
SARVAM_AUDIO_SAMPLE_RATE=8000

# --- Twilio (telephony) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public base URL for Twilio webhooks + media stream.
# Local dev: set this to your ngrok static domain (infra/ngrok/ngrok.yml), e.g.
# TWILIO_WEBHOOK_BASE_URL=https://your-app.ngrok-free.dev
TWILIO_WEBHOOK_BASE_URL=http://localhost:8000

# --- Object storage (S3-compatible) ---
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Local dev fallback directory for recordings when S3 not configured
LOCAL_STORAGE_DIR=./storage

# --- Worker / Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Call defaults ---
DEFAULT_MAX_CALL_DURATION_SECONDS=600
DEFAULT_SILENCE_TIMEOUT_SECONDS=8